#!/bin/sh
# Bewaesserung vorausschauend - Waechter, minuetlich.
# Den bin-Pfad des Plugins setzt der Installer in der Befehlszeile ein.
# Die Fehlerausgabe geht ins Protokoll, nicht nach /dev/null.
#
# LoxBerry ruft jeden Eintrag ohnehin mit '> /dev/null 2>&1' auf
# (/etc/cron.d/lbdefaults); wer sie behalten will, muss sie selbst
# umleiten - Hausstandard seit MarstekVenus 1.0.17. Ohne das steht
# nirgends, wenn dienst.sh vor seiner ersten Protokollzeile scheitert
# (kein python3, 'su' bricht ab, bin/plugins/<x>/ gerade im Umbau):
# der Waechter ist dann stumm tot.
#
# I4 (Durchgang 30.09.2026): Ordner und Datei VOR dem Aufruf anlegen und
# die Aenderungszeit auffrischen (Regeln/06, am Geraet gemessen beim
# Abfahrts-Assistenten 1.6.9): eine Umlenkung zum Anhaengen legt den
# Ordner nicht an und frischt die Aenderungszeit nicht auf - nach dem
# Leeren der Ramdisk ging die Fehlerausgabe verloren, und die Logwartung
# raeumte die Datei als alt ab.
# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
ERR="REPLACELBPLOGDIR/cron.err"
touch "$ERR" 2>/dev/null
# 0.9.46 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): ist die Fehlerdatei nicht schreibbar, braeche die
# Umlenkung den Befehl ab, BEVOR er startet - bis 0.9.45 kein Lauf und keine Spur. Dann geht die Fehlerausgabe
# nach /dev/null, und der Lauf findet statt.
[ -f "$ERR" ] && [ -w "$ERR" ] || ERR=/dev/null
# 0.9.49: auf der Ramdisk gekappt wie befehle_start.log (256 kB, letzte 300 Zeilen, Regeln/06).
if [ "$ERR" != /dev/null ] && [ "$(wc -c < "$ERR" 2>/dev/null || echo 0)" -gt 262144 ]; then
    tail -n 300 "$ERR" > "$ERR.tmp.$$" 2>/dev/null && mv -f "$ERR.tmp.$$" "$ERR" 2>/dev/null
    rm -f "$ERR.tmp.$$" 2>/dev/null
fi
"REPLACELBPBINDIR/dienst.sh" waechter >/dev/null 2>>"$ERR"
# Gruppe 2 / MQTT (0.9.44): Waechter der Befehlsbruecke (gemeinsame Stammfassung). Diese Linie hat keinen
# PHP-Minutentakt, also hier (Bauvorschrift Gruppe 1, Nachtrag 19.10.2026). Er startet die Bruecke nur mit dem
# Haken "Befehle ueber MQTT annehmen", haelt sie sonst an und sendet <praefix>/status/befehle (nie retained).
# Aufruf ueber bash (das Skript ist bash, nicht sh); stdout weg, Fehler ins Protokoll wie oben.
bash "REPLACELBPBINDIR/befehlsbruecke.sh" waechter >/dev/null 2>>"$ERR"
